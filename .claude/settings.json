{
  "permissions": {
    "allow": [
      "mcp__sqlite-readonly__list_tables",
      "mcp__sqlite-readonly__describe_table",
      "mcp__sqlite-readonly__list_foreign_keys",
      "mcp__sqlite-readonly__read_query"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.py\""
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,os,datetime; d=sys.stdin.read(); f=os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','model-switch.log'); open(f,'a',encoding='utf-8').write('[PreModelSwitch] '+datetime.datetime.now().isoformat()+'\\n'+d+'\\n\\n')\""
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,os,datetime; d=sys.stdin.read(); f=os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','model-switch.log'); open(f,'a',encoding='utf-8').write('[PostModelSwitch] '+datetime.datetime.now().isoformat()+'\\n'+d+'\\n\\n')\""
          }
        ]
      }
    ]
  }
}
